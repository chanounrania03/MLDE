# Copier en .env (non versionné) et adapter si besoin.
# Webhook d'alerte (Slack, Discord, Teams...). Laisser vide pour désactiver.
ALERT_WEBHOOK_URL=
# Serveur MLflow distant éventuel (par défaut : sqlite:///mlflow.db en local)
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Jeton exigé par POST /admin/reload (en-tête X-Admin-Token). Vide = pas de contrôle.
# Le pipeline et la commande rollback l'envoient automatiquement.
BIKEML_ADMIN_TOKEN=
# URL de l'API notifiée après une promotion
# BIKEML_API_URL=http://127.0.0.1:8000
